default_platform(:ios)

def api_key
  key_path = "/tmp/asc_key.p8"
  options = {
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    in_house: false
  }
  if File.exist?(key_path)
    options[:key_filepath] = key_path
  else
    options[:key_content] = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  end
  app_store_connect_api_key(**options)
end

platform :ios do
  def ios_project
    "DayPageLocal/DayPageLocal.xcodeproj"
  end

  desc "Build the local notebook without signing or uploading"
  lane :build_only do
    sh(
      "xcodebuild",
      "-scheme", "DayPage",
      "-project", ios_project,
      "-configuration", "Release",
      "-destination", "generic/platform=iOS",
      "-sdk", "iphoneos",
      "CODE_SIGN_IDENTITY=",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGNING_ALLOWED=NO",
      "build"
    )
  end

  desc "Build the local notebook and upload to TestFlight"
  lane :beta do
    archive_local_app
    # Processing and What to Test are verified by update-changelog.yml. Passing
    # changelog here makes Fastlane wait even with skip_waiting enabled.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.daypage.app",
      skip_waiting_for_build_processing: true
    )
    UI.success "TestFlight beta uploaded; Apple processing still requires verification"
  end

  desc "Build the local notebook and submit to App Store review"
  lane :release do
    archive_local_app
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false
    )
    UI.success "App Store submission complete"
  end

  # ADR-0027's local edition has one app target and no cloud configuration,
  # generated provider credentials, Watch/Widget/Share extensions or databases.
  private_lane :archive_local_app do
    increment_build
    release_api_key = api_key
    create_keychain(
      name: "ci_keychain",
      password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "ci_temp_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      add_to_search_list: true
    )
    match(
      type: "appstore",
      readonly: false,
      force: true,
      api_key: release_api_key,
      git_url: ENV["MATCH_GIT_URL"] || "git@github.com:getyak/daypage-certs.git",
      app_identifier: "com.daypage.app",
      keychain_name: "ci_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "ci_temp_password"
    )
    configure_release_signing
    profiles = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    build_app(
      scheme: "DayPage",
      project: ios_project,
      configuration: "Release",
      export_method: "app-store",
      clean: false,
      output_directory: "build",
      output_name: "DayPage.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV["DEVELOPMENT_TEAM"],
        provisioningProfiles: { "com.daypage.app" => profiles.fetch("com.daypage.app") }
      }
    )
  end

  # match may append a timestamp to a renewed profile. Use the exact name it
  # returned, never a checked-in or cached profile name.
  private_lane :configure_release_signing do
    profiles = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
    profile = profiles["com.daypage.app"]
    UI.user_error!("match did not provide profiles for: com.daypage.app") unless profile
    update_code_signing_settings(
      use_automatic_signing: false,
      path: ios_project,
      team_id: ENV["DEVELOPMENT_TEAM"],
      targets: ["DayPage"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )
  end

  # Avoid agvtool's generated-Info.plist path handling and leave the archived
  # multi-client project untouched.
  def set_pbxproj_version(key, value)
    path = File.expand_path("../#{ios_project}/project.pbxproj", __dir__)
    content = File.read(path)
    pattern = /#{Regexp.escape(key)} = [^;]+;/
    count = content.scan(pattern).size
    UI.user_error!("No #{key} setting in the local iOS project") if count.zero?
    File.write(path, content.gsub(pattern, "#{key} = #{value};"))
    UI.message "Local project: set #{key} = #{value} (#{count} settings)"
  end

  private_lane :increment_build do
    version = ENV["RELEASE_VERSION"].to_s.strip
    unless version.empty?
      UI.user_error!("RELEASE_VERSION must be numeric MAJOR.MINOR.PATCH") unless version =~ /\A\d+\.\d+\.\d+\z/
      set_pbxproj_version("MARKETING_VERSION", version)
    end
    # Both the deploy and asynchronous Apple check use this exact commit count.
    set_pbxproj_version("CURRENT_PROJECT_VERSION", sh("git rev-list --count HEAD").strip)
  end

  error do |lane, exception|
    UI.error "Lane #{lane} failed: #{exception.message}"
  end
end
