<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>DayPage</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>NSMicrophoneUsageDescription</key><string>Record voice notes in your local notebook. Recordings stay on this device unless you enable iCloud sync or choose to send them.</string>
  <key>NSCameraUsageDescription</key><string>Take a photo to keep with a note in your local notebook.</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>Add your current location to this note only when you choose Add location. Location is off by default.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>Optionally transcribe Watch voice notes on this iPhone. Original audio stays in your notebook; no cloud speech service is used.</string>
  <key>NSUbiquitousContainers</key><dict>
    <key>iCloud.com.daypage.app</key><dict>
      <key>NSUbiquitousContainerIsDocumentScopePublic</key><true/>
      <key>NSUbiquitousContainerName</key><string>DayPage</string>
      <key>NSUbiquitousContainerSupportedFolderLevels</key><string>Any</string>
    </dict>
  </dict>
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <key>UILaunchScreen</key><dict><key>UIColorName</key><string>NotebookPaper</string></dict>
  <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
  <key>UISupportedInterfaceOrientations~ipad</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
  <key>UIFileSharingEnabled</key><true/>
  <key>LSSupportsOpeningDocumentsInPlace</key><true/>
  <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
  <key>NSLocalNetworkUsageDescription</key><string>Connect to the local AI server you configure, only when you test the connection or send a question.</string>
  <key>UIAppFonts</key><array><string>SourceSerif4-Regular.ttf</string><string>SourceHanSerifSC-Regular.otf</string></array>
</dict></plist>
